FROM node:22.8.0-slim

RUN apt update && \
    apt install -y curl && \
    npm install -g nodemon

#Debian - Criando usuário e alterando usuarios
#RUN useradd -m -u 1000 xpto # Criando usuário com UID 1000
#RUN usermod -U 1000 xpto # Alterando UID do usuário xpto para 1000



#Alpine - Criando usuário e alterando usuarios
#RUN adduser -D -u 1000 xpto #alpine - Criando usuário com UID 1000
#RUN sed -i 's/1000/1001/g'etc/passwd # Alterando o UID do usuário xpto para 1001

USER node